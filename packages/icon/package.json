{
  "name": "@v-simple/icon",
  "type": "module",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "generate:icons": "ts-node scripts/generate-icons.ts"
  },
  "typesVersions": {
    "*": {
      "common": [
        "src/generated/common/index.ts"
      ],
      "core/*": [
        "src/core/*"
      ]
    }
  },
  "exports": {
    "./common": {
      "types": "./src/generated/common/index.ts",
      "default": "./src/generated/common/index.ts"
    },
    "./core/drawIconToCanvas": {
      "types": "./src/core/drawIconToCanvas.ts",
      "default": "./src/core/drawIconToCanvas.ts"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "svg-parser": "^2.0.4"
  }
}
